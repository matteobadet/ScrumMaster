# Copier ce fichier en `connection.env` (non commité, voir .gitignore) et renseigner la vraie
# chaîne de connexion vers la base "scrummaster" sur l'instance PostgreSQL existante du cluster.
# Ne jamais commiter connection.env : il contient un secret réel.
connectionString=Host=postgres.internal;Port=5432;Database=scrummaster;Username=scrummaster;Password=REPLACE_ME
